\name{czeCensus}
\alias{czeCensus}
\docType{data}
\title{
  Parity data from the 1991 census of the Czech Republic
}
\description{
  This dataset contains data on the population of females in the Czech Republic
  by parity (i.e. number of children born) from the 1991 census.
}
\usage{data(czeCensus)}
\format{
  A data frame with 2530 rows and 18 columns as described in the data format
  documentation available on the HFD website:
  \url{http://www.humanfertility.org/Docs/formats.pdf}.
}
\source{
Human Fertility Database \url{http://www.humanfertility.org}
}
\examples{
data(czeCensus)
}
\keyword{datasets}
